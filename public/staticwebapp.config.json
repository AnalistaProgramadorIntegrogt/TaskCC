{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/img/*",
      "/_nuxt/*",
      "/favicon.ico",
      "/*.{png,jpg,jpeg,gif,svg,webp,css,js,ico,json,woff,woff2,ttf,eot}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'"
  },
  "mimeTypes": {
    ".json": "text/json"
  }
}
